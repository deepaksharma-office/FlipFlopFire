{% doc %}
  Renders a nonempty reward card with theme/custom icons and an editable number.
  @param {object} block - Reward card block.
  @param {number} index - Visible card index for automatic animation staggering.
{% enddoc %}
{% liquid
  assign b = block.settings
  assign desktop_image = ''
  if b.icon_source == 'image' and b.image != blank
    assign desktop_image = b.image
  endif
  if b.icon == 'none' or b.icon == blank
    assign desktop_image = b.image
  endif
  assign mobile_image = b.image_mobile | default: b.image
  assign desktop_icon = false
  if desktop_image != blank or b.icon != blank and b.icon != 'none'
    assign desktop_icon = true
  endif
  assign desktop_content = false
  if b.number != blank or b.title != blank or b.description != blank or desktop_icon
    assign desktop_content = true
  endif
  assign direction = b.animation
  if direction == 'auto'
    assign directions = 'left,up,right' | split: ','
    assign direction_index = index | modulo: 3
    assign direction = directions[direction_index]
  endif
  assign delay = b.delay
  if delay < 0
    assign delay = index | times: 100 | plus: 350 | at_most: 950
  endif
%}
{% if b.enabled %}
  {% if desktop_content or mobile_image != blank %}
    <li class="rewards__card-slot{% unless desktop_content %} rewards__card-slot--mobile-only{% endunless %}" {{ block.shopify_attributes }}
      style="{% if b.accent != blank %}--card-accent: {{ b.accent }};{% endif %} --card-background: {{ b.background }}; --card-border: {{ b.border_color }}; --card-border-width: {{ b.border_width }}px; --card-radius: {{ b.radius }}px; --card-shadow: {{ b.shadow | divided_by: 100.0 }}; --card-padding: {{ b.padding }}px; --card-padding-mobile: {{ b.padding_mobile }}px; --card-height: {{ b.min_height }}px; --card-align: {{ b.alignment }}; --card-gap: {{ b.gap }}px; --icon-title-gap: {{ b.icon_gap }}px; --title-description-gap: {{ b.title_gap }}px; --icon-size: {{ b.icon_size }}px; --icon-size-mobile: {{ b.icon_size_mobile }}px; {% if b.icon_color != blank %}--icon-color: {{ b.icon_color }};{% endif %} --number-size: {{ b.badge_size }}px; --number-size-mobile: {{ b.badge_size_mobile }}px; --number-font: {{ b.badge_font }}px; --number-x: {{ b.badge_x }}px; --number-y: {{ b.badge_y }}px; --number-background: {{ b.badge_background }}; --number-color: {{ b.badge_color }}; --number-border: {{ b.badge_border }}; --number-border-width: {{ b.badge_border_width }}px; --number-radius: {{ b.badge_radius }}%; --number-gradient-end: {{ b.badge_gradient_end }}; --number-align: {{ b.badge_alignment }}; --delay: {{ delay }}ms;">
      <div class="rewards__card" {% if b.animate %}data-hero-animation="{{ direction }}"{% endif %}>
        {% if b.number != blank %}
          <div class="rewards__number-position">
            <span class="rewards__number{% if b.badge_gradient %} rewards__number--gradient{% endif %}" {% if b.animate %}data-hero-animation="scale"{% endif %} style="--delay: {{ delay | plus: 100 }}ms;">{{ b.number | escape }}</span>
          </div>
        {% endif %}
        {% if desktop_icon %}
          <span class="rewards__icon{% if mobile_image != blank %} rewards__icon--has-mobile{% endif %}" aria-hidden="true">
            {% if desktop_image != blank %}{{ desktop_image | image_url: width: 192 | image_tag: widths: '48, 96, 192', sizes: '96px', alt: '', loading: 'lazy' }}{% endif %}
            {% if desktop_image == blank and b.icon != blank and b.icon != 'none' %}{% render 'icon-or-image', icon: b.icon, width: b.icon_size, class_name: 'rewards__theme-icon' %}{% endif %}
          </span>
        {% endif %}
        {% if mobile_image != blank %}<span class="rewards__icon rewards__icon--mobile" aria-hidden="true">{{ mobile_image | image_url: width: 192 | image_tag: widths: '48, 96, 192', sizes: '96px', alt: '', loading: 'lazy' }}</span>{% endif %}
        {% if b.title != blank %}<{{ b.title_level }} class="rewards__card-title" style="--title-size: {{ b.title_size }}px; --title-size-mobile: {{ b.title_size_mobile }}px; --title-weight: {{ b.title_weight }}; --title-color: {{ b.title_color }}; --title-spacing: {{ b.title_spacing }}em; --title-line-height: {{ b.title_line_height }}; --title-width: {{ b.title_width }}px;">{{ b.title | escape }}</{{ b.title_level }}>{% endif %}
        {% if b.description != blank %}<div class="rewards__card-description rte" style="--description-size: {{ b.description_size }}px; --description-size-mobile: {{ b.description_size_mobile }}px; --description-color: {{ b.description_color }}; --description-line-height: {{ b.description_line_height }}; --description-width: {{ b.description_width }}px;">{{ b.description }}</div>{% endif %}
        {% if b.number == blank and b.title == blank and b.description == blank and b.icon_label != blank %}<span class="visually-hidden">{{ b.icon_label | escape }}</span>{% endif %}
      </div>
    </li>
  {% endif %}
{% endif %}
