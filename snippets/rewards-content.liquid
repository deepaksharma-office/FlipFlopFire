{% doc %}
  Renders a nonempty rewards introduction or CTA block.
  @param {object} block - Content block.
{% enddoc %}
{% liquid
  assign b = block.settings
  assign show = false
  if b.enabled
    if block.type == 'button' and b.label != blank and b.link != blank
      assign show = true
    endif
    if block.type != 'button' and b.text != blank
      assign show = true
    endif
    if block.type == 'heading' and b.accent_text != blank
      assign show = true
    endif
  endif
%}
{% if show %}
  <div class="rewards__block rewards__block--{{ block.type }}{% if block.type == 'button' and b.width == '100%' %} rewards__block--button-full{% endif %}" {{ block.shopify_attributes }}
    style="--block-width: {{ b.max_width }}px; --block-align: {{ b.alignment }}; --block-color: {{ b.color }}; --font-desktop: {{ b.font_size }}px; --font-mobile: {{ b.font_mobile }}px; --font-weight: {{ b.weight }}; --letter-spacing: {{ b.letter_spacing }}em; --line-height: {{ b.line_height }}; --text-case: {{ b.text_case }}; --space-top: {{ b.space_top }}px; --space-bottom: {{ b.space_bottom }}px; --delay: {{ b.delay }}ms;">
    <div {% if b.animate %}data-hero-animation="{{ b.animation }}"{% endif %}>
      {% case block.type %}
        {% when 'eyebrow' %}<p class="rewards__eyebrow">{{ b.text | escape }}</p>
        {% when 'heading' %}
          <{{ b.heading_level }} class="rewards__heading">
            {% if b.text != blank %}<span>{{ b.text }}</span>{% endif %}
            {% if b.accent_text != blank %}<span class="rewards__accent{% if b.gradient %} rewards__accent--gradient{% endif %}" style="--accent-one: {{ b.accent_one }}; --accent-two: {{ b.accent_two }}; --accent-angle: {{ b.gradient_angle }}deg;">{{ b.accent_text }}</span>{% endif %}
          </{{ b.heading_level }}>
        {% when 'text' %}<div class="rewards__description rte">{{ b.text }}</div>
        {% when 'button' %}
          <a class="rewards__button rewards__button--{{ b.style }} rewards__button--{{ b.hover }}" href="{{ b.link }}" {% if b.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            style="--button-background: {{ b.background }}; --gradient-start: {{ b.gradient_start }}; --gradient-end: {{ b.gradient_end }}; --button-border: {{ b.border_color }}; --button-border-width: {{ b.border_width }}px; --button-radius: {{ b.radius }}px; --button-px: {{ b.padding_x }}px; --button-py: {{ b.padding_y }}px; --button-width: {{ b.width }};">{{ b.label | escape }}</a>
      {% endcase %}
    </div>
  </div>
{% endif %}
