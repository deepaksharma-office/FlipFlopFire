{% liquid
  assign s = section.settings
  assign card_count = 0
  assign desktop_count = 0
  assign reserve = 0
  assign reserve_mobile = 0
%}
{% capture intro %}
  {% for block in section.blocks %}{% if block.type != 'card' and block.type != 'button' %}{% render 'rewards-content', block: block %}{% endif %}{% endfor %}
{% endcapture %}
{% capture actions %}
  {% for block in section.blocks %}{% if block.type == 'button' %}{% render 'rewards-content', block: block %}{% endif %}{% endfor %}
{% endcapture %}
{% capture cards %}
  {% for block in section.blocks %}
    {% if block.type == 'card' %}
      {% capture item %}{% render 'rewards-card', block: block, index: card_count %}{% endcapture %}
      {% assign item = item | strip %}
      {% if item != blank %}
        {{ item }}
        {% liquid
          assign card_count = card_count | plus: 1
          assign b = block.settings
          if b.number != blank or b.title != blank or b.description != blank or b.image != blank
            assign desktop_count = desktop_count | plus: 1
          elsif b.icon != blank and b.icon != 'none'
            assign desktop_count = desktop_count | plus: 1
          endif
          if b.number != blank
            assign extra = b.badge_y | times: -1 | at_least: 0
            assign overhang = b.badge_size | divided_by: 2.0 | plus: extra
            assign overhang_mobile = b.badge_size_mobile | divided_by: 2.0 | plus: extra
            assign reserve = reserve | at_least: overhang
            assign reserve_mobile = reserve_mobile | at_least: overhang_mobile
          endif
        %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endcapture %}
{% liquid
  assign intro = intro | strip
  assign actions = actions | strip
  assign cards = cards | strip
  assign columns = s.columns | plus: 0 | at_most: desktop_count | at_least: 1
  assign tablet_columns = columns | at_most: 2
%}
{% if intro != blank or actions != blank or cards != blank %}
  {{ 'rewards-program.css' | asset_url | stylesheet_tag }}
  {% if s.animate %}<script src="{{ 'cinematic-hero.js' | asset_url }}" defer></script>{% endif %}
  <section {% if s.label != blank %}aria-label="{{ s.label | escape }}"{% endif %}>
    <cinematic-hero class="rewards{% if intro == blank and actions == blank and desktop_count == 0 %} rewards--mobile-only{% endif %}" data-animate="{{ s.animate }}"
      style="--rewards-background: {{ s.background }}; {% if s.accent != blank %}--rewards-accent: {{ s.accent }};{% endif %} --rewards-width: {{ s.content_width }}px; --group-gap: {{ s.group_gap }}px; --cta-gap: {{ s.cta_gap }}px; --card-grid-gap: {{ s.card_gap }}px; --card-max-width: {{ s.card_width }}px; --columns-desktop: {{ columns }}; --columns-tablet: {{ tablet_columns }}; --badge-reserve: {{ reserve }}px; --badge-reserve-mobile: {{ reserve_mobile }}px; --padding-top: {{ s.padding_top_desktop }}px; --padding-bottom: {{ s.padding_bottom_desktop }}px; --padding-x: {{ s.padding_x_desktop }}px; --padding-top-tablet: {{ s.padding_top_tablet }}px; --padding-bottom-tablet: {{ s.padding_bottom_tablet }}px; --padding-x-tablet: {{ s.padding_x_tablet }}px; --padding-top-mobile: {{ s.padding_top_mobile }}px; --padding-bottom-mobile: {{ s.padding_bottom_mobile }}px; --padding-x-mobile: {{ s.padding_x_mobile }}px; --duration: {{ s.duration }}ms; --background-fit: {{ s.background_fit }}; --background-position: {{ s.background_position }}; --overlay-color: {{ s.overlay_color }}; --overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};">
      {% if s.background_image != blank %}<div class="rewards__background" aria-hidden="true" {% if s.animate %}data-hero-animation="fade"{% endif %}>{{ s.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1440, 1920, 2400', sizes: '100vw', alt: '', loading: 'lazy' }}</div>{% endif %}
      {% if s.overlay %}<div class="rewards__overlay" aria-hidden="true"></div>{% endif %}
      <div class="rewards__inner">
        {% if intro != blank %}<div class="rewards__intro">{{ intro }}</div>{% endif %}
        {% if cards != blank %}<ul class="rewards__cards{% if desktop_count == 0 %} rewards__cards--mobile-only{% endif %}" role="list">{{ cards }}</ul>{% endif %}
        {% if actions != blank %}<div class="rewards__actions">{{ actions }}</div>{% endif %}
      </div>
    </cinematic-hero>
  </section>
{% endif %}

