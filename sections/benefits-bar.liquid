{% liquid
  assign s = section.settings
  assign desktop_content = false
%}
{% capture items %}
  {% for block in section.blocks %}
    {% render 'benefits-bar-item', block: block %}
    {% liquid
      if block.settings.text != blank or block.settings.image != blank
        assign desktop_content = true
      endif
      if block.settings.icon != blank and block.settings.icon != 'none'
        assign desktop_content = true
      endif
    %}
  {% endfor %}
{% endcapture %}
{% assign items = items | strip %}
{% if items != blank %}
  {{ 'benefits-bar.css' | asset_url | stylesheet_tag }}
  <div
    class="benefits-bar benefits-bar--{{ s.mobile_layout }}{% if s.dividers %} benefits-bar--dividers{% endif %}{% unless desktop_content %} benefits-bar--mobile-only{% endunless %}"
    style="--benefits-background: {{ s.background }}; --benefits-color: {{ s.text_color }}; --benefits-border-color: {{ s.border_color }}; --benefits-border-width: {{ s.border_width }}px; --benefits-width: {{ s.content_width }}px; --benefits-padding: {{ s.padding }}px; --benefits-padding-mobile: {{ s.padding_mobile }}px; --benefits-alignment: {{ s.alignment }}; --benefits-spacing: {{ s.spacing }}px; --benefits-divider-color: {{ s.divider_color }}; --benefits-divider-width: {{ s.divider_width }}px; --benefits-icon-color: {{ s.icon_color }}; --benefits-icon-size: {{ s.icon_size }}px; --benefits-icon-size-mobile: {{ s.icon_size_mobile }}px; --benefits-icon-gap: {{ s.icon_gap }}px; --benefits-font-size: {{ s.font_size }}px; --benefits-font-size-mobile: {{ s.font_size_mobile }}px; --benefits-font-weight: {{ s.font_weight }}; --benefits-line-height: {{ s.line_height }}; --benefits-slide-width: {{ s.slide_width }};"
  >
    <div class="benefits-bar__inner">
      <ul class="benefits-bar__list" role="list" aria-label="{{ s.label | escape }}" {% if s.mobile_layout == 'slide' %}tabindex="0"{% endif %}>
        {{ items }}
      </ul>
    </div>
  </div>
{% endif %}

