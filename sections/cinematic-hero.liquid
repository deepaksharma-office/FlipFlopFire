{% liquid
  assign s = section.settings
  assign background = s.background_image | default: s.background_mobile
  assign featured = s.image | default: s.image_mobile
  assign image_alt = s.image_alt | default: featured.alt
  assign has_review = false
  if s.review_enabled
    if s.rating != blank or s.reviews != blank
      assign has_review = true
    endif
  endif
  assign has_visual = false
  if featured != blank or has_review
    assign has_visual = true
  endif
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
%}
{% capture content %}
  {% for block in section.blocks %}
    {% if block.settings.placement == 'content' %}{% render 'cinematic-hero-block', block: block %}{% endif %}
  {% endfor %}
{% endcapture %}
{% capture bottom %}
  {% for block in section.blocks %}
    {% if block.settings.placement == 'bottom' %}{% render 'cinematic-hero-block', block: block %}{% endif %}
  {% endfor %}
{% endcapture %}
{% liquid
  assign content = content | strip
  assign bottom = bottom | strip
%}
{{ 'cinematic-hero.css' | asset_url | stylesheet_tag }}
{% if s.animate %}<script src="{{ 'cinematic-hero.js' | asset_url }}" defer></script>{% endif %}
<cinematic-hero
  class="cinematic-hero"
  data-animate="{{ s.animate }}"
  style="--hero-bg: {{ s.background_color }}; --hero-color: {{ s.text_color }}; --hero-width: {{ s.content_width }}px; --gutter: {{ s.gutter }}px; --hero-gap: {{ s.gap }}px; --height-desktop: {{ s.height_desktop }}px; --height-tablet: {{ s.height_tablet }}px; --height-mobile: {{ s.height_mobile }}px; --padding-desktop: {{ s.padding_desktop }}px; --padding-tablet: {{ s.padding_tablet }}px; --padding-mobile: {{ s.padding_mobile }}px; --bg-fit: {{ s.background_fit }}; --bg-x: {{ s.background_x }}%; --bg-y: {{ s.background_y }}%; --overlay-color: {{ s.overlay_color }}; --overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }}; {% if s.overlay_gradient != blank %}--overlay-gradient: {{ s.overlay_gradient }};{% endif %}"
>
  {% if background != blank %}
    <div class="cinematic-hero__background" aria-hidden="true">
      <picture {% if s.background_animate %}data-hero-animation="scale"{% endif %}>
        {% if s.background_mobile != blank %}
          <source media="(max-width: 749px)" srcset="{{ s.background_mobile | image_url: width: 480 }} 480w, {{ s.background_mobile | image_url: width: 750 }} 750w, {{ s.background_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
        {% endif %}
        {{ background | image_url: width: 2400 | image_tag: widths: '750, 1100, 1440, 1920, 2400', sizes: '100vw', alt: '', loading: image_loading, fetchpriority: image_priority }}
      </picture>
    </div>
  {% endif %}
  <div class="cinematic-hero__overlay" aria-hidden="true"></div>
  <div class="cinematic-hero__inner">
    {% if content != blank or has_visual %}
      <div class="cinematic-hero__layout{% if content != blank and has_visual %} cinematic-hero__layout--split{% endif %}">
        {% if content != blank %}<div class="cinematic-hero__content">{{ content }}</div>{% endif %}
        {% if has_visual %}
          <div class="cinematic-hero__visual{% if featured != blank %} cinematic-hero__visual--with-image{% endif %}" style="--review-overlap: {{ s.review_overlap_desktop }}px; --review-overlap-tablet: {{ s.review_overlap_tablet }}px; --review-overlap-mobile: {{ s.review_overlap_mobile }}px;">
            {% if featured != blank %}
              <div class="cinematic-hero__image-position cinematic-hero__position" style="{% render 'cinematic-hero-position', settings: s, prefix: 'image_' %} --image-width: {{ s.image_width }}px; --duration: {{ s.image_duration }}ms; --delay: {{ s.image_delay }}ms;">
                <div class="cinematic-hero__image" {% if s.image_animate %}data-hero-animation="{{ s.image_animation }}"{% endif %} style="--image-ratio: {{ s.image_ratio }}; --image-radius: {{ s.image_radius }}px; --image-fit: {{ s.image_fit }}; --image-position: {{ s.image_position }};">
                  <picture>
                    {% if s.image_mobile != blank %}
                      <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 375 }} 375w, {{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w" sizes="(max-width: 749px) calc(100vw - 40px), 50vw">
                    {% endif %}
                    {{ featured | image_url: width: 1600 | image_tag: widths: '375, 550, 750, 1100, 1600', sizes: '(max-width: 749px) calc(100vw - 40px), (max-width: 1099px) 45vw, 600px', alt: image_alt, loading: image_loading }}
                  </picture>
                </div>
              </div>
            {% endif %}
            {% if has_review %}
              <div class="cinematic-hero__review-position cinematic-hero__position" style="{% render 'cinematic-hero-position', settings: s, prefix: 'review_' %} --review-width: {{ s.review_width }}px; --duration: {{ s.review_duration }}ms; --delay: {{ s.review_delay }}ms;">
                <div class="cinematic-hero__review" {% if s.review_animate %}data-hero-animation="{{ s.review_animation }}"{% endif %} style="--review-bg: {{ s.review_background }}; --review-color: {{ s.review_color }}; --star-color: {{ s.star_color }}; --review-border: {{ s.review_border }}; --review-border-width: {{ s.review_border_width }}px; --review-radius: {{ s.review_radius }}px; --review-padding: {{ s.review_padding }}px;">
                  {% if s.rating != blank or s.review_icon != blank %}
                    <div class="cinematic-hero__review-summary">
                      {% if s.review_icon != blank %}{{ s.review_icon | image_url: width: 64 | image_tag: class: 'cinematic-hero__review-icon', width: 24, height: 24, alt: '', loading: 'lazy' }}{% endif %}
                      {% if s.rating != blank %}<span class="cinematic-hero__rating">{{ s.rating | escape }}</span>{% endif %}
                      {% if s.show_stars and s.rating != blank %}<span class="cinematic-hero__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>{% endif %}
                    </div>
                  {% endif %}
                  {% if s.reviews != blank %}<p class="cinematic-hero__reviews">{{ s.reviews | escape }}</p>{% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}
    {% if bottom != blank %}<div class="cinematic-hero__bottom">{{ bottom }}</div>{% endif %}
  </div>
</cinematic-hero>

