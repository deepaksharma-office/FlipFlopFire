{% liquid
  assign s = section.settings
  assign show_form = false
  if s.show_form and s.button_label != blank
    assign show_form = true
  endif
%}
{% if s.eyebrow != blank or s.heading != blank or s.description != blank or show_form %}
  {{ 'newsletter-crew.css' | asset_url | stylesheet_tag }}
  {% if s.animate %}<script src="{{ 'cinematic-hero.js' | asset_url }}" defer></script>{% endif %}
  <section {% if s.heading != blank %}aria-label="{{ s.heading | strip_html | escape }}"{% endif %}>
    <cinematic-hero class="newsletter-crew{% if s.background_gradient %} newsletter-crew--gradient{% endif %}" data-animate="{{ s.animate }}" style="--newsletter-background: {{ s.background }}; --background-start: {{ s.background_start }}; --background-end: {{ s.background_end }}; --background-angle: {{ s.background_angle }}deg; --background-fit: {{ s.background_fit }}; --background-position: {{ s.background_position }}; --overlay-color: {{ s.overlay_color }}; --overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }}; --content-width: {{ s.content_width }}px; --form-width: {{ s.form_width }}px; --field-gap: {{ s.field_gap }}px; --input-background: {{ s.input_background }}; --input-color: {{ s.input_color }}; --placeholder-color: {{ s.placeholder_color }}; --input-border: {{ s.input_border }}; --focus-color: {{ s.focus_color }}; --input-border-width: {{ s.input_border_width }}px; --input-radius: {{ s.input_radius }}px; --field-height: {{ s.field_height }}px; --field-height-mobile: {{ s.field_height_mobile }}px; --input-padding: {{ s.input_padding }}px; --input-padding-mobile: {{ s.input_padding_mobile }}px; --input-size: {{ s.input_size }}px; --input-size-mobile: {{ s.input_size_mobile }}px; --button-background: {{ s.button_background }}; --button-start: {{ s.button_start }}; --button-end: {{ s.button_end }}; --button-angle: {{ s.button_angle }}deg; --button-color: {{ s.button_color }}; --button-border: {{ s.button_border }}; --button-border-width: {{ s.button_border_width }}px; --button-radius: {{ s.button_radius }}px; --button-size: {{ s.button_size }}px; --button-size-mobile: {{ s.button_size_mobile }}px; --button-weight: {{ s.button_weight }}; --button-padding: {{ s.button_padding }}px; --button-width: {{ s.button_width }}; --message-color: {{ s.message_color }}; --error-color: {{ s.error_color }}; --border-top: {{ s.border_top }}px; --border-bottom: {{ s.border_bottom }}px; --border-color: {{ s.border_color }}; --duration: {{ s.duration }}ms; --padding-top: {{ s.padding_top_desktop }}px; --padding-bottom: {{ s.padding_bottom_desktop }}px; --padding-x: {{ s.padding_x_desktop }}px; --padding-top-tablet: {{ s.padding_top_tablet }}px; --padding-bottom-tablet: {{ s.padding_bottom_tablet }}px; --padding-x-tablet: {{ s.padding_x_tablet }}px; --padding-top-mobile: {{ s.padding_top_mobile }}px; --padding-bottom-mobile: {{ s.padding_bottom_mobile }}px; --padding-x-mobile: {{ s.padding_x_mobile }}px; --newsletter-color: {{ s.input_color }};">
      {% if s.background_image != blank %}<div class="newsletter-crew__background" aria-hidden="true" {% if s.animate %}data-hero-animation="fade"{% endif %}>{{ s.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1440, 1920, 2400', sizes: '100vw', alt: '', loading: 'lazy' }}</div>{% endif %}
      {% if s.overlay %}<div class="newsletter-crew__overlay" aria-hidden="true"></div>{% endif %}
      <div class="newsletter-crew__inner">
        {% render 'newsletter-crew-copy', settings: s, kind: 'eyebrow' %}
        {% render 'newsletter-crew-copy', settings: s, kind: 'heading' %}
        {% render 'newsletter-crew-copy', settings: s, kind: 'description' %}
        {% if show_form %}
          {% render 'newsletter-crew-form', section: section %}
          {% render 'newsletter-crew-copy', settings: s, kind: 'privacy' %}
        {% endif %}
      </div>
    </cinematic-hero>
  </section>
{% endif %}

