{% liquid
  assign s = section.settings
  assign featured = s.image | default: s.image_mobile
  assign image_alt = s.image_alt | default: featured.alt
  assign show_badge = false
  if s.badge_enabled and featured != blank
    if s.badge_label != blank or s.badge_text != blank or s.badge_secondary != blank
      assign show_badge = true
    endif
  endif
  assign badge_image = ''
  if s.badge_source == 'image' and s.badge_image != blank
    assign badge_image = s.badge_image
  endif
  if s.badge_icon == 'none' or s.badge_icon == blank
    assign badge_image = s.badge_image
  endif
  assign image_loading = 'lazy'
  if section.index == 1
    assign image_loading = 'eager'
  endif
%}
{% capture content %}
  {% for block in section.blocks %}{% render 'brand-story-block', block: block %}{% endfor %}
{% endcapture %}
{% assign content = content | strip %}
{% if featured != blank or content != blank %}
  {{ 'brand-story.css' | asset_url | stylesheet_tag }}
  {% if s.animate %}<script src="{{ 'cinematic-hero.js' | asset_url }}" defer></script>{% endif %}
  <section {% if s.accessibility_label != blank %}aria-label="{{ s.accessibility_label | escape }}"{% endif %}>
    <cinematic-hero class="brand-story" data-animate="{{ s.animate }}"
      style="--story-background: {{ s.background }}; --story-width: {{ s.content_width }}px; --story-gap: {{ s.gap }}px; --vertical-align: {{ s.vertical_align }}; --padding-top: {{ s.padding_top }}px; --padding-bottom: {{ s.padding_bottom }}px; --padding-x: {{ s.padding_x }}px; --padding-tablet: {{ s.padding_tablet }}px; --padding-mobile: {{ s.padding_mobile }}px; --padding-x-mobile: {{ s.padding_x_mobile }}px; --duration: {{ s.duration }}ms; --overlay-color: {{ s.overlay_color }}; --overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};">
      {% if s.background_image != blank %}<div class="brand-story__background" aria-hidden="true">{{ s.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1440, 1920, 2400', sizes: '100vw', alt: '', loading: image_loading }}</div>{% endif %}
      {% if s.overlay_enabled %}<div class="brand-story__overlay" aria-hidden="true"></div>{% endif %}
      <div class="brand-story__inner">
        <div class="brand-story__grid{% if featured != blank and content != blank %} brand-story__grid--split{% endif %}">
          {% if featured != blank %}
            <div class="brand-story__visual brand-story__position" style="{% render 'cinematic-hero-position', settings: s, prefix: 'image_' %} --image-width: {{ s.image_width }}px; --image-radius: {{ s.image_radius }}px;">
              <div class="brand-story__image-group">
                {% if s.glow %}
                  <div class="brand-story__glow" aria-hidden="true" {% if s.glow_animate %}data-hero-animation="scale"{% endif %} style="--delay: 100ms; --glow-color: {{ s.glow_color }}; --glow-strength: {{ s.glow_opacity | times: s.glow_intensity | divided_by: 10000.0 }}; --glow-blur: {{ s.glow_blur }}px; --glow-spread: {{ s.glow_spread }}px; --glow-size: {{ s.glow_size }}%; --glow-x: {{ s.glow_x }}px; --glow-y: {{ s.glow_y }}px;"></div>
                {% endif %}
                <div class="brand-story__image" {% if s.image_animate %}data-hero-animation="left"{% endif %}
                  style="--image-ratio: {{ s.image_ratio }}; --image-ratio-mobile: {{ s.image_ratio_mobile }}; {% if s.image_height > 0 %}--image-height: {{ s.image_height }}px;{% endif %}{% if s.image_height_mobile > 0 %}--image-height-mobile: {{ s.image_height_mobile }}px;{% endif %} --image-fit: {{ s.image_fit }}; --image-object-x: {{ s.image_object_x }}%; --image-object-y: {{ s.image_object_y }}%; --image-object-x-mobile: {{ s.image_object_x_mobile }}%; --image-object-y-mobile: {{ s.image_object_y_mobile }}%; --image-grayscale: {{ s.grayscale }}%; --image-opacity: {{ s.image_opacity | divided_by: 100.0 }}; --image-border: {{ s.image_border }}; --image-border-width: {{ s.image_border_width }}px;">
                  <picture>
                    {% if s.image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 375 }} 375w, {{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w" sizes="calc(100vw - 48px)">{% endif %}
                    {{ featured | image_url: width: 1600 | image_tag: widths: '375, 550, 750, 1100, 1600', sizes: '(max-width: 749px) calc(100vw - 48px), (max-width: 1099px) 45vw, 600px', alt: image_alt, loading: image_loading }}
                  </picture>
                </div>
              </div>
              {% if show_badge %}
                <div class="brand-story__badge-position brand-story__position" style="{% render 'cinematic-hero-position', settings: s, prefix: 'badge_' %} --badge-width: {{ s.badge_width }}px;">
                  <div class="brand-story__badge" {% if s.badge_animate %}data-hero-animation="up"{% endif %} style="--delay: 550ms; --badge-background: {{ s.badge_background }}; --badge-color: {{ s.badge_color }}; --badge-accent: {{ s.badge_accent }}; --badge-border: {{ s.badge_border }}; --badge-border-width: {{ s.badge_border_width }}px; --badge-radius: {{ s.badge_radius }}px; --badge-padding: {{ s.badge_padding }}px; --badge-shadow: {{ s.badge_shadow | divided_by: 100.0 }}; --badge-icon-size: {{ s.badge_icon_size }}px; --badge-icon-color: {{ s.badge_icon_color }};">
                    {% if badge_image != blank or s.badge_icon != blank and s.badge_icon != 'none' %}
                      <span class="brand-story__badge-icon{% if s.badge_image_mobile != blank %} brand-story__badge-icon--has-mobile{% endif %}" aria-hidden="true">
                        {% if badge_image != blank %}{{ badge_image | image_url: width: 96 | image_tag: widths: '32, 64, 96', sizes: '48px', alt: '', loading: 'lazy' }}{% endif %}
                        {% if badge_image == blank and s.badge_icon != blank and s.badge_icon != 'none' %}{% render 'icon-or-image', icon: s.badge_icon, width: s.badge_icon_size, class_name: 'brand-story__theme-icon' %}{% endif %}
                      </span>
                    {% endif %}
                    {% if s.badge_image_mobile != blank %}<span class="brand-story__badge-icon brand-story__badge-icon--mobile" aria-hidden="true">{{ s.badge_image_mobile | image_url: width: 96 | image_tag: widths: '32, 64, 96', sizes: '48px', alt: '', loading: 'lazy' }}</span>{% endif %}
                    <div class="brand-story__badge-copy">
                      {% if s.badge_label != blank %}<p class="brand-story__badge-label">{{ s.badge_label | escape }}</p>{% endif %}
                      {% if s.badge_text != blank %}<p class="brand-story__badge-title">{{ s.badge_text | escape }}</p>{% endif %}
                      {% if s.badge_secondary != blank %}<p class="brand-story__badge-secondary">{{ s.badge_secondary | escape }}</p>{% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
          {% endif %}
          {% if content != blank %}<div class="brand-story__content">{{ content }}</div>{% endif %}
        </div>
      </div>
    </cinematic-hero>
  </section>
{% endif %}

